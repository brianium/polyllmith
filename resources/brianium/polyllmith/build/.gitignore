# Clojure/Java
target/
classes/
*.jar
*.class
pom.xml
pom.xml.asc

# Clojure tools
.cpcache/
.nrepl-port
.lsp/
# clj-kondo: only our hand-maintained config (.clj-kondo/config.edn) and
# hooks (.clj-kondo/hooks/) are tracked. Everything else under .clj-kondo/ is
# generated — the cache plus per-library configs that clj-kondo copies in from
# dependencies. Ignore all subdirs, re-include only hooks/.
.clj-kondo/*/
!.clj-kondo/hooks/
# Ignore .clj-kondo directories created in subdirectories
*/**/.clj-kondo/
# clj-kondo inline-config cache (generated by lint runs)
.clj-kondo/inline-configs/

# ClojureScript (if added later)
.shadow-cljs/
node_modules/
out/
resources/public/js/

# Editors
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
.calva/

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/projects/
.claude/settings.local.json
.claude/worktrees/

# Secrets
.env
.env.local

# Local databases
*.db

# Python cache
__pycache__/

# Browser brick — default per-profile user-data-dirs (per-workstation state)
.browser-profiles/

# Ephemeral workspaces
.scratch/
