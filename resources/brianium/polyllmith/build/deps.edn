{:deps {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {;; Development — wires every brick onto the classpath via :local/root.
  ;; When creating a new brick, add it here (and its test paths to :test).
  :dev {:extra-paths ["development/src" "development/resources"]
        :extra-deps {{{top/ns}}.{{main/ns}}/secrets {:local/root "components/secrets"}
                     {{top/ns}}.{{main/ns}}/browser {:local/root "components/browser"}

                     integrant/integrant            {:mvn/version "1.0.1"}
                     io.github.tonsky/clj-reload    {:mvn/version "1.0.0"}}}

  :test {:extra-paths ["components/secrets/test"
                       "components/browser/test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"
                     "-d" "components/secrets/test"
                     "-d" "components/browser/test"]}}}
